{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "checkend",
	"main": "src/entry/worker.ts",
	"compatibility_date": "2026-10-06",
	"observability": { "enabled": true },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "checkend",
			"migrations_dir": "migrations"
		}
	]
}
