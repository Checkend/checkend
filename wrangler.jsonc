{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "checkend",
	"main": "src/entry/worker.ts",
	"compatibility_date": "2026-10-06",
	"observability": { "enabled": true },
	// One schedule for all jobs (fix verification, retries, retention); the Worker decides by the time.
	"triggers": { "crons": ["*/5 * * * *"] },
	// This file is also the deploy-button config: only what a new Workers Free account can deploy.
	// Optional bindings (a rate limit per DSN key, R2, Queues, Email) are in the docs; the Worker
	// detects them at runtime and works without them.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "checkend",
			"migrations_dir": "migrations"
		}
	]
}
