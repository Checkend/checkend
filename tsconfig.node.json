{
	// Node runtime: the portable layers, the Node adapter, Node tests and tool configs.
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"types": ["node"]
	},
	"exclude": ["test/fixtures/sentry/browser-app.ts"],
	"include": [
		"src/core/**/*.ts",
		"src/ports/**/*.ts",
		"src/http/**/*.ts",
		"src/adapters/node/**/*.ts",
		"test/contract/**/*.ts",
		"test/node/**/*.ts",
		"test/fixtures/**/*.ts",
		"test/support/**/*.ts",
		"*.config.ts"
	]
}
