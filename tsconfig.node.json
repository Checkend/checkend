{
	// Node runtime: the portable layers, the Node adapter, Node tests and tool configs.
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"types": ["node"],
		// create-checkend is plain JavaScript (npx runs it from node_modules), typed with JSDoc.
		"allowJs": true,
		"checkJs": true
	},
	"exclude": ["test/fixtures/sentry/browser-app.ts"],
	"include": [
		"src/core/**/*.ts",
		"src/ports/**/*.ts",
		"src/http/**/*.ts",
		"src/adapters/node/**/*.ts",
		"src/adapters/config-env.ts",
		"src/entry/server.ts",
		"test/contract/**/*.ts",
		"test/node/**/*.ts",
		"test/fixtures/**/*.ts",
		"test/support/**/*.ts",
		"test/perf/**/*.ts",
		"scripts/**/*.ts",
		"bench/**/*.ts",
		"packages/**/*.mjs",
		"*.config.ts"
	]
}
