#!/usr/bin/env bash
# Block private planning files and secrets from the public repo.
# Enable once per clone: git config core.hooksPath .githooks

status=0

# 1. Paths that belong to checkend-internal.
blocked=$(git diff --cached --name-only --diff-filter=ACMR -z |
  tr '\0' '\n' |
  /usr/bin/grep -E '^(docs(/|$)|TODO\.md$|handover\.md$|INTERNAL\.md$|REVIEW\.md$|wrangler\.[^/]+\.jsonc$)')
if [ -n "$blocked" ]; then
  echo "pre-commit: these private or per-instance files must not be committed:" >&2
  echo "$blocked" | sed 's/^/  /' >&2
  status=1
fi

# 2. Any staged symlink that points into checkend-internal.
git diff --cached --name-only --diff-filter=ACMR -z |
  while IFS= read -r -d '' path; do
    mode=$(git ls-files -s -- "$path" | cut -d' ' -f1)
    [ "$mode" = "120000" ] || continue
    target=$(git cat-file -p ":$path")
    case "$target" in
      *checkend-internal*) echo "pre-commit: $path is a symlink into checkend-internal ($target)" >&2; exit 1 ;;
    esac
  done || status=1

# 3. Secrets in the staged changes (gitleaks, with the rules in .gitleaks.toml).
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --staged --pre-commit --redact --no-banner --log-level warn -c .gitleaks.toml .; then
    echo "pre-commit: gitleaks found a possible secret in the staged changes (see above)." >&2
    echo "Remove it, and rotate it if it is real. A fake test value must contain 'test' or 'example'." >&2
    status=1
  fi
else
  echo "pre-commit: gitleaks is not installed, so the secret scan cannot run." >&2
  echo "Install it (for example: brew install gitleaks), then commit again." >&2
  status=1
fi

if [ "$status" -ne 0 ]; then
  echo "Unstage files with: git restore --staged <path>" >&2
fi
exit $status
